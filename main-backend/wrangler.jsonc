{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "main-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "remain.scar0x00.click/api/v1/*", "zone_name": "scar0x00.click" },
    // MCP endpoint. Protected by Cloudflare Access with Managed OAuth enabled.
    { "pattern": "remain.scar0x00.click/mcp", "zone_name": "scar0x00.click" }
  ],
  // Used to verify the Access JWT on /mcp. AUD is the Application Audience (AUD) tag of the
  // Access application that covers /mcp; fill it in from Zero Trust > Access > Applications.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://scar0x00.cloudflareaccess.com",
    "ACCESS_AUD": "0c24cfd80b60bd24ef9f666a5bd0348b71c81c2d42577c7683d5c4a907ffa656",
    // PostHog (usage analytics). The token, POSTHOG_KEY, is a Worker secret in production only
    // (`wrangler secret put POSTHOG_KEY`), so `wrangler dev`, tests and CI send nothing.
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "DECKS",
      "bucket_name": "remain-decks"
    }
  ],
  "services": [
    {
      "binding": "FLASHCARD_AGENT",
      "service": "flashcard-generator-agent"
    }
  ],
  "hyperdrive": [
    {
      "binding": "PG",
      "id": "b88dd980fff34df78181d1cfcfbf04c7"
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
}