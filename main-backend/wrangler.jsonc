{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "main-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "DECKS",
      "bucket_name": "remain-decks"
    }
  ],
  "services": [
    {
      "binding": "FLASHCARD_AGENT",
      "service": "flashcard-generator-agent"
    }
  ],
  "hyperdrive": [
    {
      "binding": "PG",
      "id": "b88dd980fff34df78181d1cfcfbf04c7"
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
}