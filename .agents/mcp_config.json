{
    "mcpServers": {
        "obscura-browser": {
            "command": "obscura",
            "args": [
                "mcp"
            ]
        },
        "cloudflare-docs": {
            "serverUrl": "https://docs.mcp.cloudflare.com/mcp"
        },
        "angular-cli": {
          "command": "pnpx",
          "args": ["-y", "@angular/cli", "mcp"]
        }
    }
}